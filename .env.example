# Copiá este archivo a .env para desarrollo local. En producción los valores
# viven en Azure Key Vault; nunca se suben al repositorio.

# Base de datos
DATABASE_URL=postgres://avance_api:avance_api@localhost:5432/avance_obra
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/avance_obra

# Almacenamiento (Azurite local; en producción, cuenta de Azure Storage)
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_CONTAINER=avance-obra

# API
JWT_SECRETO=cambiar-por-una-cadena-larga-al-azar
PUERTO=8080

# IA (módulo de informes)
ANTHROPIC_API_KEY=

# Clientes
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api
API_URL_INTERNA=http://localhost:8080
